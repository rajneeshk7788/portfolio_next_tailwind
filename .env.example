# Copy to .env.local (local) or set in your build environment (deployment).

# Public URL of the deployed site. Used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://port-folio-aed8e.web.app

# Form service endpoint that delivers contact form messages to your inbox,
# for example https://formspree.io/f/your_form_id
# If left empty, the form opens the visitor's email app with the message filled in.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
